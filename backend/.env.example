# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
#
# For local Docker (docker-compose), the DATABASE_URL values below are fine.
# For staging/production, point DATABASE_URL at your real Postgres instance
# (not the internal `db` service) and update CORS_ORIGINS to your staging URL.

DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/aetherix
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@db_test:5432/aetherix_test

# JWT secret — used by app/core/security.py and app/services/users.py
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=changeme-generate-with-secrets.token_hex-32

MAIL_SERVER=mailhog

# Comma-separated origins (no JSON brackets).
CORS_ORIGINS=http://localhost:3000

# ── Supabase (PostgreSQL + pgvector) ─────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...

# ── Redis (session state — Upstash or local) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Claude is always the primary LLM. Gemini is always the automatic fallback.
# If Claude fails (API error, rate limit, timeout), Gemini takes over
# transparently — no configuration or human action required.

# Anthropic — primary LLM (Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — automatic fallback (Gemini 2.0 Flash)
# Get key at: aistudio.google.com (free tier available)
GEMINI_API_KEY=

# LLM backend selector: "claude" (default) | "gemini" | "openai"
LLM_BACKEND=claude
LLM_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=gemini-2.0-flash

# ── Embedding Provider ─────────────────────────────────────────────────────────
# Mistral produces 1024-dimensional vectors matching the pgvector column in fb_patterns.
MISTRAL_API_KEY=...
EMBEDDING_BACKEND=mistral
EMBEDDING_MODEL=mistral-embed

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to load synthetic 365-day Prophet training data from
# backend/data/demo/prophet_training.json instead of live Apaleo data.
DEMO_MODE=false

# ── Twilio (WhatsApp + SMS) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# WhatsApp sender number — used by whatsapp_service.py and explainability_service.py
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# WhatsApp sender for twilio_client.py / config.py (same value as above, different key)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Plain SMS/voice number (E.164) — fallback in explainability_service.py
TWILIO_FROM_NUMBER=+15005550006
# Set to true in CI/test to skip Twilio HMAC signature validation on inbound webhooks
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# ── SendGrid (Email alerts) ───────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@aetherix.io

# ── PredictHQ (Local events data) ─────────────────────────────────────────────
PREDICTHQ_API_KEY=...

# ── Anomaly Detection ─────────────────────────────────────────────────────────
# Percentage deviation threshold above which a demand anomaly is flagged (default 20.0)
ANOMALY_DEVIATION_THRESHOLD=20.0

# ── Apaleo (PMS) ──────────────────────────────────────────────────────────────
APALEO_CLIENT_ID=...
APALEO_CLIENT_SECRET=...
# Direct MCP Server (Streamable HTTP — SSE deprecated). Scope MCP must be enabled on the Apaleo account.
APALEO_MCP_SERVER_URL=https://mcp.apaleo.com/mcp/
# Phase 0: read-only guard. Set to false only when writes are explicitly validated.
APALEO_READONLY=true
# Apaleo MCP via Composio — Inventory API only (Décision #21).
COMPOSIO_API_KEY=...

# ── Observability (HOS-311) ───────────────────────────────────────────────────
# Pydantic Logfire — optional. Absent or empty is a no-op: instrumentation
# silently does nothing rather than failing startup.
LOGFIRE_TOKEN=

# ── Obsidian vault (knowledge base — synced via OneDrive) ─────────────────────
# Set this to your local vault path. Docker bind-mounts it at /vault.
# Examples:
#   Windows/WSL: /mnt/c/Users/YOURNAME/OneDrive/Documents/Agentic AI Hospitality
#   macOS/Linux: /Users/YOURNAME/Documents/vault
OBSIDIAN_VAULT_PATH=/tmp/vault

# ── Linear (issue & task tracking) ───────────────────────────────────────────
LINEAR_API_KEY=lin_api_...
# IMPORTANT: use the HOS team UUID, not TAC. Verify with: python scripts/linear_teams.py
LINEAR_TEAM_ID=2f6bb5e2-d735-4769-9377-11fe186aa0ad

# ── RGPD — pseudonymisation & rétention (Story 7.5 / HOS-115) ────────────────
# Poivre serveur des digests d'identifiants stockés (expéditeur WhatsApp,
# guest_id PMS). SANS VALEUR PAR DÉFAUT VOLONTAIREMENT : un poivre partagé entre
# déploiements ne poivre rien. Vide → l'app refuse de stocker un digest plutôt
# que de retomber silencieusement sur un sha256 nu (récupérable en secondes sur
# l'espace des numéros de téléphone).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_HASH_PEPPER=
# Durée de conservation des messages entrants, en jours (défaut 90).
CONVERSATIONAL_QUERY_RETENTION_DAYS=90
# Heure UTC de la purge quotidienne (défaut 3).
RETENTION_PURGE_HOUR=3
