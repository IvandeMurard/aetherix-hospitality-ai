{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-brief.schema.json",
  "title": "Aetherix pilot brief",
  "description": "Typed form of the one-page pilot brief in docs/pilot/onboarding-kit.md section 1. The kit is the source of truth; if they disagree, fix this file. Status: Design. An agent may draft the brief; a human fills every decision point (docs/mcp/getting-started.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem",
    "baseline",
    "owner",
    "authority_level",
    "pms_access",
    "destination",
    "measures",
    "stop_conditions",
    "decision_points",
    "drafted_by"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "One sentence, in the hotel's own words. One problem only."
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "weekly_planning_minutes", "measured_on"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 3,
          "description": "What the hotel does today, e.g. 'mean of the last 4 same weekdays' or 'own spreadsheet'. Measured before the pilot, not cleaned up."
        },
        "weekly_planning_minutes": { "type": "number", "minimum": 0 },
        "measured_on": { "type": "string", "format": "date" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "description": "One named person on the hotel side who reads the Receipt and corrects it. Keep personal data to the minimum."
    },
    "authority_level": {
      "const": "L0_recommend_human_validates",
      "description": "Aetherix recommends, the hotel validates (Decision 6, ADR-0013 level L0). The schema admits no other level: raising it is a separate, evidenced decision."
    },
    "pms_access": {
      "const": "read_only",
      "description": "Decision 7."
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "routine"],
      "properties": {
        "channel": { "enum": ["whatsapp", "email"] },
        "routine": {
          "type": "string",
          "minLength": 3,
          "description": "The routine in which the recommendation is read, e.g. 'morning Receipt before the briefing'."
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "fixed_before_results"],
        "properties": {
          "id": {
            "enum": [
              "forecast_vs_baseline_at_decision_horizon",
              "recommendations_accepted_or_corrected",
              "time_saved"
            ]
          },
          "description": { "type": "string", "minLength": 3 },
          "fixed_before_results": { "const": true }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "decision_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week_2", "week_4"],
      "properties": {
        "week_2": { "$ref": "#/$defs/decision_week_2" },
        "week_4": { "$ref": "#/$defs/decision_week_4" }
      },
      "description": "Week 2: first written decision. Week 4 applies only if the hotel chose to continue at week 2."
    },
    "drafted_by": { "enum": ["human", "agent"] },
    "approved_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "on"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "on": { "type": "string", "format": "date" }
      },
      "description": "The hotel decision-maker who approved the brief. Absent until a human has."
    }
  },
  "$defs": {
    "decision_record": {
      "type": "object",
      "required": ["decision", "decided_by", "decided_on", "rationale"],
      "properties": {
        "decided_by": {
          "enum": ["human", null],
          "description": "Always a human. An agent never fills a decision point."
        },
        "decided_on": { "type": ["string", "null"], "format": "date" },
        "rationale": { "type": ["string", "null"] }
      }
    },
    "decision_week_2": {
      "allOf": [
        { "$ref": "#/$defs/decision_record" },
        {
          "type": "object",
          "properties": {
            "decision": { "enum": ["stop", "revise", "continue", null] }
          }
        }
      ]
    },
    "decision_week_4": {
      "allOf": [
        { "$ref": "#/$defs/decision_record" },
        {
          "type": "object",
          "properties": {
            "decision": { "enum": ["stop", "continue", "extend", null] }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "problem": "Know how many covers to expect at dinner so that I can set the team the day before.",
      "baseline": {
        "method": "mean of the last 4 same weekdays, in my spreadsheet",
        "weekly_planning_minutes": 90,
        "measured_on": "2026-11-10"
      },
      "owner": { "name": "F&B manager", "role": "F&B manager" },
      "authority_level": "L0_recommend_human_validates",
      "pms_access": "read_only",
      "destination": { "channel": "whatsapp", "routine": "morning Receipt before the briefing" },
      "measures": [
        {
          "id": "forecast_vs_baseline_at_decision_horizon",
          "description": "Gap against my baseline at the horizon where I can still change the rota.",
          "fixed_before_results": true
        },
        {
          "id": "recommendations_accepted_or_corrected",
          "description": "Share of recommendations I accept or correct.",
          "fixed_before_results": true
        }
      ],
      "stop_conditions": ["No reply from the owner for one week", "Data access blocked for more than 3 days"],
      "decision_points": {
        "week_2": { "decision": null, "decided_by": null, "decided_on": null, "rationale": null },
        "week_4": { "decision": null, "decided_by": null, "decided_on": null, "rationale": null }
      },
      "drafted_by": "agent"
    }
  ]
}
